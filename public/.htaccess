# PROSPERi5 Apache Configuration (.htaccess)
# Handles Single Page Application (SPA) Client-Side Routing & Cross-Origin Resource Sharing (CORS)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. CORS Headers configuration
  <IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE, PATCH"
    Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, Access-Control-Allow-Origin"
  </IfModule>

  # 2. Serve physical files/directories directly (images, css, js, json, svg, webp, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA Client-Side Routing: Redirect all non-file route paths (/careers, /blog, /about, /tools, etc.) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# 4. GZIP / Deflate Compression for Fast Page Loads
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# 5. Media & Assets Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
